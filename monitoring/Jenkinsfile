pipeline {
    agent none

    options {
        disableConcurrentBuilds()
    }

    environment {
        MONITORING_NAMESPACE      = 'monitoring'
        PROMETHEUS_RELEASE_NAME   = 'prometheus'
        GRAFANA_RELEASE_NAME      = 'grafana'
        HELM_POD_YAML             = 'jenkins-pods/helm-pod.yaml'
        WAIT_TIMEOUT              = '360s'
    }

    stages {

        stage('Prepare Monitoring Environment') { // Init helm, plugins, namespace
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    script {
                        echo 'Checking Kubernetes context…'
                        sh 'kubectl config current-context'
                        echo 'Adding/Updating Helm repos…'
                        sh 'helm repo add bitnami https://charts.bitnami.com/bitnami || true'
                        sh 'helm repo update'
                        echo 'Ensuring helm-diff plugin present…'
                        sh 'helm plugin list | grep -q diff || helm plugin install https://github.com/databus23/helm-diff'
                        echo 'Creating monitoring namespace (idempotent)…'
                        sh "kubectl create namespace ${MONITORING_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -"
                    }
                }
            }
        }

        stage('Apply Monitoring Secrets') { // Grafana credentials and SMTP
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    script {
                        sh "kubectl apply -f monitoring/grafana-admin-secret.yaml -n ${MONITORING_NAMESPACE}"
                        sh "kubectl apply -f monitoring/grafana-smtp-secret.yaml -n ${MONITORING_NAMESPACE}"
                    }
                }
            }
        }

        stage('Apply Grafana Dashboards ConfigMap') { // Dashboards provisioning
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "kubectl apply -f monitoring/grafana-all-dashboards-configmap.yaml -n ${MONITORING_NAMESPACE}"
                }
            }
        }

        stage('Apply Prometheus Server ConfigMap (Alert Rules)') { // Alert rules
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "kubectl apply -f monitoring/current-prometheus-server-configmap.yaml -n ${MONITORING_NAMESPACE}"
                }
            }
        }

        stage('Preview Prometheus Changes') { // Helm diff for Prometheus
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "helm diff upgrade ${PROMETHEUS_RELEASE_NAME} bitnami/prometheus -f monitoring/prometheus-values.yaml -n ${MONITORING_NAMESPACE} || true"
                }
            }
        }

        stage('Deploy Prometheus') { // Install or upgrade Prometheus
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "helm upgrade --install ${PROMETHEUS_RELEASE_NAME} bitnami/prometheus -f monitoring/prometheus-values.yaml -n ${MONITORING_NAMESPACE} --debug"
                    sh "kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=prometheus,app.kubernetes.io/component=server -n ${MONITORING_NAMESPACE} --timeout=${WAIT_TIMEOUT}"
                }
            }
        }

        stage('Preview Grafana Changes') { // Helm diff for Grafana
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "helm diff upgrade ${GRAFANA_RELEASE_NAME} bitnami/grafana -f monitoring/grafana-values.yaml -n ${MONITORING_NAMESPACE} || true"
                }
            }
        }

        stage('Deploy Grafana') { // Install or upgrade Grafana
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    sh "helm upgrade --install ${GRAFANA_RELEASE_NAME} bitnami/grafana -f monitoring/grafana-values.yaml -n ${MONITORING_NAMESPACE} --debug"
                    sh "kubectl wait --for=condition=ready pod -l app.kubernetes.io/name=grafana -n ${MONITORING_NAMESPACE} --timeout=${WAIT_TIMEOUT}"
                }
            }
        }

        stage('Post‑Deployment Info') { // Show service URLs and pod status
            agent { kubernetes { yamlFile "${HELM_POD_YAML}" } }
            steps {
                container('helm') {
                    script {
                        def grafanaServiceInfo = sh(returnStdout: true, script: "kubectl get svc ${GRAFANA_RELEASE_NAME} -n ${MONITORING_NAMESPACE} -o jsonpath='{.spec.ports[?(@.name==\"http\")].nodePort}'").trim()
                        def prometheusServiceInfo = sh(returnStdout: true, script: "kubectl get svc ${PROMETHEUS_RELEASE_NAME}-server -n ${MONITORING_NAMESPACE} -o jsonpath='{.spec.ports[?(@.name==\"http\")].nodePort}'").trim()
                        def alertmanagerServiceInfo = sh(returnStdout: true, script: "kubectl get svc ${PROMETHEUS_RELEASE_NAME}-alertmanager -n ${MONITORING_NAMESPACE} -o jsonpath='{.spec.ports[?(@.name==\"web\")].nodePort}'").trim()
                        def clusterNodeIp = sh(returnStdout: true, script: "kubectl get nodes -o jsonpath='{.items[0].status.addresses[?(@.type==\"InternalIP\")].address}'").trim()

                        echo "--------------------------------------------------------"
                        echo "Monitoring service endpoints:"
                        echo "--------------------------------------------------------"

                        if (grafanaServiceInfo && clusterNodeIp) {
                            echo "Grafana  http://${clusterNodeIp}:${grafanaServiceInfo}/grafana/"
                        } else {
                            echo "Grafana  http://${GRAFANA_RELEASE_NAME}.${MONITORING_NAMESPACE}.svc.cluster.local:80"
                        }

                        if (prometheusServiceInfo && clusterNodeIp) {
                            echo "Prometheus ➜ http://${clusterNodeIp}:${prometheusServiceInfo}"
                        } else {
                            echo "Prometheus  http://${PROMETHEUS_RELEASE_NAME}-server.${MONITORING_NAMESPACE}.svc.cluster.local:80"
                        }

                        if (alertmanagerServiceInfo && clusterNodeIp) {
                            echo "Alertmanager  http://${clusterNodeIp}:${alertmanagerServiceInfo}"
                        } else {
                            echo "Alertmanager  http://${PROMETHEUS_RELEASE_NAME}-alertmanager.${MONITORING_NAMESPACE}.svc.cluster.local:80"
                        }

                        echo "--------------------------------------------------------"
                        echo "Pod status in namespace '${MONITORING_NAMESPACE}':"
                        sh "kubectl get pods -n ${MONITORING_NAMESPACE}"
                        echo "--------------------------------------------------------"
                    }
                }
            }
        }
    }

    post {
        always   { echo 'Monitoring pipeline finished.' }
        failure  { echo 'Monitoring pipeline FAILED – check logs.' }
        success  { echo 'Monitoring pipeline completed successfully.' }
    }
}
